<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
</head>
<body style="margin:0; padding:0; background:#f4f4f4; font-family: Arial, sans-serif;">
  <div style="max-width:600px; margin:40px auto; background:white; border-radius:8px; overflow:hidden; box-shadow:0 2px 8px rgba(0,0,0,0.1);">
    
    <!-- HEADER -->
    <div style="background:#16a34a; padding:24px 32px;">
      <h1 style="color:white; margin:0; font-size:22px;">New Post Pending Review</h1>
    </div>

    <!-- BODY -->
    <div style="padding:32px;">
      <p style="color:#333; font-size:15px; margin-top:0;">
        Hi Admin, a new post has been submitted and is waiting for your approval.
      </p>

      <table style="width:100%; border-collapse:collapse; margin:20px 0;">
        <tr style="background:#f9fafb;">
          <td style="padding:10px 14px; font-weight:bold; color:#555; font-size:13px; width:120px;">Title</td>
          <td style="padding:10px 14px; color:#111; font-size:13px;"><%= postTitle %></td>
        </tr>
        <tr>
          <td style="padding:10px 14px; font-weight:bold; color:#555; font-size:13px;">Category</td>
          <td style="padding:10px 14px; color:#111; font-size:13px; text-transform:capitalize;"><%= category %></td>
        </tr>
        <tr style="background:#f9fafb;">
          <td style="padding:10px 14px; font-weight:bold; color:#555; font-size:13px;">Author</td>
          <td style="padding:10px 14px; color:#111; font-size:13px;"><%= authorName %></td>
        </tr>
        <tr>
          <td style="padding:10px 14px; font-weight:bold; color:#555; font-size:13px;">Submitted</td>
          <td style="padding:10px 14px; color:#111; font-size:13px;"><%= submittedAt %></td>
        </tr>
      </table>

      <a
        href="<%= reviewUrl %>"
        style="display:inline-block; background:#16a34a; color:white; padding:12px 28px; border-radius:6px; text-decoration:none; font-weight:bold; font-size:14px; margin-top:8px;"
      >
        Review Post →
      </a>
    </div>

    <!-- FOOTER -->
    <div style="background:#f9fafb; padding:16px 32px; border-top:1px solid #e5e7eb;">
      <p style="color:#999; font-size:12px; margin:0;">AmeboNaija — Admin Notification</p>
    </div>

  </div>
</body>
</html>